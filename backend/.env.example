# ---- Server ----
PORT=4000
NODE_ENV=development
# Frontend base URL, used for building the password-reset link
FRONTEND_URL=http://localhost:3000

# ---- Database ----
# NOTE: the DB name ("StudyNotion") is appended in code, so keep the trailing slash
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# ---- JWT ----
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_API_KEY=your_api_key
CLOUDINARY_CLOUD_API_SECRET=your_api_secret

# ---- Mail (nodemailer) ----
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
# Where the Contact Us form delivers; defaults to MAIL_USER when unset
CONTACT_MAIL_TO=support@yourdomain.com

# ---- Razorpay ----
RAZORPAY_KEY=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_key_secret
# Set this to the same value configured on the Razorpay webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- CORS (only needed in production; dev uses the Vite proxy) ----
CORS_ORIGIN=http://localhost:3000
