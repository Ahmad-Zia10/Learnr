# Razorpay public key id (safe to expose; the secret stays on the backend)
VITE_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxx

# Where the API lives. Leave empty in development: requests stay relative and
# the Vite proxy forwards them to localhost:4000.
# In production set it to the API origin, no trailing slash, and add this same
# frontend origin to the backend's CORS_ORIGIN.
# Vite inlines this at build time, so changing it needs a rebuild.
VITE_API_URL=
